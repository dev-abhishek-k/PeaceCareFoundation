generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  HELP_SEEKER
  NGO_REP
  VOLUNTEER
  ADMIN
}

enum NGOStatus {
  PENDING
  MORE_INFO
  APPROVED
  REJECTED
  SUSPENDED
}

enum HelpRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  NGO_SUGGESTED
  SHARED_WITH_NGO
  ACCEPTED
  DECLINED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Urgency {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ContactMethod {
  EMAIL
  PHONE
  WHATSAPP
}

enum MatchStatus {
  SUGGESTED
  SHARED
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum OpportunityStatus {
  PENDING
  APPROVED
  CLOSED
}

enum ComplaintStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model User {
  id                   String                 @id @default(cuid())
  fullName             String
  email                String                 @unique
  phone                String?
  passwordHash         String
  role                 UserRole               @default(HELP_SEEKER)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  sessions             Session[]
  ownedNGO             NGO?
  helpRequests         HelpRequest[]          @relation("Requester")
  statusChanges        StatusHistory[]        @relation("StatusActor")
  notifications        Notification[]
  documents            PrivateDocument[]      @relation("Uploader")
  complaints           Complaint[]            @relation("ComplaintReporter")
  handledComplaints    Complaint[]            @relation("ComplaintHandler")
  volunteerApplication VolunteerApplication?
  opportunityApps      OpportunityApplication[]
  auditEntries         AuditLog[]             @relation("AuditActor")

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model SupportCategory {
  id        String        @id @default(cuid())
  name      String        @unique
  slug      String        @unique
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  ngos      NGOCategory[]
  requests  HelpRequest[]
}

model NGO {
  id                    String           @id @default(cuid())
  ownerUserId           String           @unique
  name                  String
  description           String           @db.Text
  registrationDetails   String           @db.Text
  serviceLocations      String[]
  contactName           String
  contactEmail          String
  contactPhone          String?
  preferredContact      ContactMethod    @default(EMAIL)
  publicDonationUrl     String?
  donationLinkApproved  Boolean          @default(false)
  status                NGOStatus        @default(PENDING)
  verificationNote      String?          @db.Text
  reviewedAt            DateTime?
  reviewedById          String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  owner                 User             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  categories            NGOCategory[]
  matches               NGOMatch[]
  documents             PrivateDocument[]
  opportunities         Opportunity[]

  @@index([status, createdAt])
  @@index([name])
}

model NGOCategory {
  ngoId      String
  categoryId String
  ngo        NGO             @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  category   SupportCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([ngoId, categoryId])
  @@index([categoryId])
}

model HelpRequest {
  id                    String            @id @default(cuid())
  requesterId           String
  categoryId            String
  description           String            @db.Text
  city                  String
  state                 String
  pinCode               String
  urgency               Urgency           @default(NORMAL)
  preferredContact      ContactMethod
  contactPhone          String?
  shareConsent          Boolean
  status                HelpRequestStatus @default(SUBMITTED)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  requester             User              @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  category              SupportCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  history               StatusHistory[]
  matches               NGOMatch[]
  documents             PrivateDocument[]
  complaints            Complaint[]
  notifications         Notification[]

  @@index([requesterId, createdAt])
  @@index([status, urgency, createdAt])
  @@index([city, state])
}

model NGOMatch {
  id          String      @id @default(cuid())
  requestId   String
  ngoId       String
  status      MatchStatus @default(SUGGESTED)
  note        String?     @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  sharedAt    DateTime?
  respondedAt DateTime?
  request     HelpRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  ngo         NGO         @relation(fields: [ngoId], references: [id], onDelete: Cascade)

  @@unique([requestId, ngoId])
  @@index([ngoId, status, createdAt])
  @@index([requestId, status])
}

model StatusHistory {
  id         String            @id @default(cuid())
  requestId  String
  actorId    String?
  fromStatus HelpRequestStatus?
  toStatus   HelpRequestStatus
  note       String?           @db.Text
  createdAt  DateTime          @default(now())
  request    HelpRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor      User?             @relation("StatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
}

model PrivateDocument {
  id           String      @id @default(cuid())
  fileName     String
  mimeType     String
  size         Int
  content      Bytes
  uploaderId   String
  ngoId        String?
  helpRequestId String?
  createdAt    DateTime    @default(now())
  uploader     User        @relation("Uploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  ngo          NGO?        @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  helpRequest  HelpRequest? @relation(fields: [helpRequestId], references: [id], onDelete: Cascade)

  @@index([ngoId, createdAt])
  @@index([helpRequestId, createdAt])
}

model VolunteerApplication {
  id          String   @id @default(cuid())
  userId      String   @unique
  city        String
  state       String
  skills      String[]
  motivation  String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Opportunity {
  id           String                    @id @default(cuid())
  ngoId        String
  title        String
  description  String                    @db.Text
  location     String
  status       OpportunityStatus         @default(PENDING)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  ngo          NGO                       @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  applications OpportunityApplication[]

  @@index([status, createdAt])
}

model OpportunityApplication {
  id            String      @id @default(cuid())
  opportunityId String
  volunteerId   String
  message       String?     @db.Text
  createdAt     DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  volunteer     User        @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, volunteerId])
}

model Complaint {
  id           String          @id @default(cuid())
  reporterId   String
  requestId    String?
  subject      String
  details      String          @db.Text
  status       ComplaintStatus @default(OPEN)
  resolution   String?         @db.Text
  handledById  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  reporter     User            @relation("ComplaintReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  request      HelpRequest?    @relation(fields: [requestId], references: [id], onDelete: SetNull)
  handledBy    User?           @relation("ComplaintHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model Notification {
  id        String      @id @default(cuid())
  userId    String
  requestId String?
  title     String
  message   String      @db.Text
  readAt    DateTime?
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  request   HelpRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  reason     String?
  createdAt  DateTime @default(now())
  actor      User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}